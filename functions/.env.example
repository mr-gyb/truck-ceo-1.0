# Local emulator / dev only. NEVER commit a real key here.
# Production uses Cloud Secrets (Secret Manager), wired via
# `secrets: ["GEMINI_API_KEY", "META_MODEL_API_KEY", "OPENAI_API_KEY"]`
# in src/index.ts. Only the ACTIVE provider's key is required at runtime.
#
# ── Provider selection ──────────────────────────────────────────────────
# gemini (default, day-1 ship target) | meta | openai
MODEL_PROVIDER=gemini

# ── Primary provider key — REQUIRED for deploy/day-1 ────────────────────
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=<redacted>

# ── Fallback provider keys — only required when MODEL_PROVIDER selects them ──
# Meta Muse Spark: https://dev.meta.ai/ (Start building -> add payment method -> create API key)
META_MODEL_API_KEY=<redacted>
# OpenAI: https://platform.openai.com/ -> API keys
OPENAI_API_KEY=<redacted>
