# Firebase Storage security rules for the TruckCEO role model
# ------------------------------------------------------------------
# STAGED REMEDY (2026-11-07) — not yet deployed. Ship it only if the
# live retest confirms settlement uploads are blocked at the Storage
# layer. It deploys via the "Deploy Storage rules (non-blocking)"
# step in .github/workflows/firebase-hosting-merge.yml, or manually
# in the Firebase console: Storage > Rules, then Publish.
#
# WARNING: deploying Storage rules REPLACES whatever rules are
# currently configured in the console for the WHOLE bucket
# (truck-ceo.firebasestorage.app). Every client Storage path the app
# uses today is therefore covered below — do not deploy a partial
# version of this file:
#   businesses/{bid}/settlement-uploads/**  SettlementUploader (owner)
#   businesses/{bid}/csv-uploads/**         CSVUploader / CSVService
#   driver-photos/{bid}/**                  DriverHome photo uploads
# The settlement processing function reads uploads server-side via
# the Admin SDK, which bypasses these rules entirely.
#
# Model (mirrors firestore.rules exactly):
#   users/{uid}  -> { role: 'business_owner' | 'team_member', businessId }
#   A signed-in user may touch only the paths of the business named
#   in their own users doc. Upload UIs are owner-only, so writes on
#   the two upload prefixes require the owner role; driver photos
#   are written by team members, so that prefix allows members.
#   Everything else is denied by default (no match = no access).
#
# Like firestore.rules, matches are explicit per path segment (no
# recursive wildcards): the client code only ever writes flat file
# names under these prefixes.

rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAuthed() {
      return request.auth != null;
    }

    // Storage rules read the ownership model from Firestore; only the
    // (default) database is reachable from here. A missing users doc
    // makes this error, which fails closed (deny).
    function myProfile() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }

    function myBusiness() {
      return myProfile().businessId;
    }

    function isMyBusiness(bid) {
      return isAuthed() && myBusiness() == bid;
    }

    function isOwner() {
      return isAuthed() && myProfile().role == 'business_owner';
    }

    // Flowers settlement PDFs (SettlementUploader). Owner uploads;
    // business members may read back (e.g. a future in-app viewer).
    // Processing happens server-side via Admin SDK, not these rules.
    match /businesses/{bid}/settlement-uploads/{fileName} {
      allow read: if isMyBusiness(bid);
      allow write: if isMyBusiness(bid) && isOwner();
    }

    // CSV imports (CSVUploader / services/csvService.ts). Same shape
    // as settlements: owner-gated UI, member read for parity.
    match /businesses/{bid}/csv-uploads/{fileName} {
      allow read: if isMyBusiness(bid);
      allow write: if isMyBusiness(bid) && isOwner();
    }

    // Driver route photos (DriverHome). Path is driver-photos/{bid}/
    // {routeId}/{dayId}/{uid}_{timestamp}_{name}; drivers are team
    // members, so members of the business may read and write here.
    match /driver-photos/{bid}/{routeId}/{dayId}/{fileName} {
      allow read, write: if isMyBusiness(bid);
    }

    // No other paths match: default deny for everything else in the
    // bucket, signed in or not.
  }
}
