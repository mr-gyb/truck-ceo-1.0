# Firestore + Storage security rules for the TruckCEO role model
# ------------------------------------------------------------------
# These are NOT auto-deployed (firebase.json only deploys hosting).
# Apply them in the Firebase console: Firestore Database > Rules
# (and Storage > Rules for the second block), then Publish.
#
# Model:
#   users/{uid}                -> { role: 'business_owner' | 'team_member', businessId, employeeId?, routeIds? }
#   inviteCodes/{CODE}         -> global lookup for driver join (readable by any authed user)
#   businesses/{bid}/...      -> everything under a business is tenant-isolated
#   businesses/{bid}/routes/{rid}/eod|photos|updates -> driver-submitted data

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthed() {
      return request.auth != null;
    }

    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function myBusiness() {
      return myProfile().businessId;
    }

    // Invite codes: any signed-in user can read (driver join flow).
    // Only owners create them (via the app, which writes both docs).
    match /inviteCodes/{code} {
      allow read: if isAuthed();
      allow create: if isAuthed() && myProfile().role == 'business_owner';
      allow update: if isAuthed(); // usedCount increment on join
      allow delete: if isAuthed() && myProfile().role == 'business_owner';
    }

    // Users: you can read/create/update your own doc.
    // Owners can read the user docs of their business members.
    match /users/{uid} {
      allow read: if isAuthed() && (request.auth.uid == uid || myBusiness() == resource.data.businessId);
      allow create: if isAuthed() && request.auth.uid == uid;
      allow update: if isAuthed() && request.auth.uid == uid;
    }

    // Businesses: full tenant isolation. You can only touch your own business.
    match /businesses/{bid} {
      allow read, write: if isAuthed() && myBusiness() == bid;

      // AI assistant threads: tenant members can READ (chat history);
      // only the backend function (Admin SDK) writes. Carved out of the
      // wildcard below so clients can never write threads or messages.
      match /assistantThreads/{tid} {
        allow read: if isAuthed() && myBusiness() == bid;
        match /messages/{mid} {
          allow read: if isAuthed() && myBusiness() == bid;
        }
      }

      match /{subcollection=**} {
        allow read, write: if isAuthed() && myBusiness() == bid
          && subcollection[0] != 'assistantThreads';
      }
    }

    // ------------------------------------------------------------------
    // AI assistant collections (added 2026-09-28). These ride along with
    // the already-pending console paste of this file (owed since 2026-09-26).
    //
    // agentInbox: a business owner can read their own business's items.
    // Only the backend function (Admin SDK) writes. Drivers see the
    // reply via their readable assistant thread, not the inbox itself.
    match /agentInbox/{id} {
      allow read: if isAuthed()
        && myProfile().role == 'business_owner'
        && resource.data.businessId == myBusiness();
    }

    // assistant_config (the brain file): function-only via Admin SDK.
    // No client access at all.
    match /assistant_config/{doc} {
      allow read, write: if false;
    }
  }
}

