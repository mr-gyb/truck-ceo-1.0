// Firestore + Storage security rules for the TruckCEO role model
// ------------------------------------------------------------------
// These are NOT auto-deployed (firebase.json only deploys hosting).
// Apply them in the Firebase console: Firestore Database > Rules
// (and Storage > Rules for the second block), then Publish.
//
// Model:
//   users/{uid}                -> { role: 'business_owner' | 'team_member', businessId, employeeId?, routeIds? }
//   inviteCodes/{CODE}         -> global lookup for driver join (readable by any authed user)
//   businesses/{bid}/...      -> everything under a business is tenant-isolated
//   businesses/{bid}/routes/{rid}/eod|photos|updates -> driver-submitted data
//
// 2026-09-30: Replaced the recursive /{subcollection=**} wildcard with
// explicit per-collection matches. The wildcard's list (query) evaluation
// was denying reads ("Missing or insufficient permissions") while single-doc
// gets on the same paths were allowed. Explicit matches keep identical
// tenant-isolation semantics with predictable list behavior.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthed() {
      return request.auth != null;
    }

    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function myBusiness() {
      return myProfile().businessId;
    }

    function isMyBusiness(bid) {
      return isAuthed() && myBusiness() == bid;
    }

    // Invite codes: any signed-in user can read (driver join flow).
    // Only owners create them (via the app, which writes both docs).
    match /inviteCodes/{code} {
      allow read: if isAuthed();
      allow create: if isAuthed() && myProfile().role == 'business_owner';
      allow update: if isAuthed(); // usedCount increment on join
      allow delete: if isAuthed() && myProfile().role == 'business_owner';
    }

    // Users: you can read/create/update your own doc.
    // Owners can read the user docs of their business members.
    match /users/{uid} {
      allow read: if isAuthed() && (request.auth.uid == uid || myBusiness() == resource.data.businessId);
      allow create: if isAuthed() && request.auth.uid == uid;
      allow update: if isAuthed() && request.auth.uid == uid;
    }

    // Businesses: full tenant isolation. You can only touch your own business.
    match /businesses/{bid} {
      allow read, write: if isMyBusiness(bid);

      // AI assistant threads: tenant members can READ (chat history);
      // only the backend function (Admin SDK) writes.
      match /assistantThreads/{tid} {
        allow read: if isMyBusiness(bid);
        match /messages/{mid} {
          allow read: if isMyBusiness(bid);
        }
      }

      // Invite links: business members can read; only owners create/revoke.
      // Members may bump ONLY usedCount (a driver join increments it) and
      // may create their own redemption record — both were impossible under
      // the owner-only write, which is why joins never registered here.
      // NOTE (2026-11-08): the owner UI reads counts from the global
      // inviteCodes doc, which any signed-in user may update, so joins
      // register even before this rules update is published.
      match /invites/{code} {
        allow read: if isMyBusiness(bid);
        allow create, delete: if isMyBusiness(bid) && myProfile().role == 'business_owner';
        allow update: if isMyBusiness(bid)
          && (myProfile().role == 'business_owner'
              || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedCount']));
        match /redemptions/{uid} {
          allow read: if isMyBusiness(bid);
          allow create: if isMyBusiness(bid) && request.auth.uid == uid;
          allow update, delete: if false;
        }
      }

      // Data-source connection status: written only by the backend function
      // (Admin SDK bypasses rules). Clients can read the status pills.
      match /connections/{cid} {
        allow read: if isMyBusiness(bid);
        allow write: if false;
      }

      // Operational alerts (truck issues, store problems, staffing gaps):
      // canonical store written by the assistant backend via Admin SDK.
      // Business members can read them for display; only owners manage them
      // in-app.
      match /alerts/{aid} {
        allow read: if isMyBusiness(bid);
        allow write: if isMyBusiness(bid) && myProfile().role == 'business_owner';
      }

      // Routes + driver-submitted nested data (EOD, photos, updates).
      // Members of the business can read/write their own business's data.
      match /routes/{rid} {
        allow read, write: if isMyBusiness(bid);
        match /eod/{eid} {
          allow read, write: if isMyBusiness(bid);
        }
        match /photos/{pid} {
          allow read, write: if isMyBusiness(bid);
        }
        match /updates/{updid} {
          allow read, write: if isMyBusiness(bid);
        }
        // Weekly Driver Scores (driver app "My Score" tab). This match was
        // MISSING — the read was denied outright, and the tab hung on its
        // loading skeleton (2026-11-08 defect). Members read; scores are
        // written by the backend (Admin SDK) or owners.
        match /driverScores/{sid} {
          allow read: if isMyBusiness(bid);
          allow write: if isMyBusiness(bid) && myProfile().role == 'business_owner';
        }

        // ---- Data intake (added 2026-11-06; see docs/data-intake-design.md
        // and functions/src/settlements). Records are written by the
        // backend parser via Admin SDK (bypasses rules). Members can read;
        // only owners can write from a client (manual repair path). ----
        match /settlements/{weekEnding} {
          allow read: if isMyBusiness(bid);
          allow write: if isMyBusiness(bid) && myProfile().role == 'business_owner';
        }
        match /shrinkReports/{weekEnding} {
          allow read: if isMyBusiness(bid);
          allow write: if isMyBusiness(bid) && myProfile().role == 'business_owner';
        }
        // Customer Margin Detail provenance copies (store rows are also
        // merged onto the week's settlement record by the backend).
        match /marginDetails/{weekEnding} {
          allow read: if isMyBusiness(bid);
          allow write: if isMyBusiness(bid) && myProfile().role == 'business_owner';
        }
        match /stalesReports/{weekEnding} {
          allow read: if isMyBusiness(bid);
          allow write: if isMyBusiness(bid) && myProfile().role == 'business_owner';
        }
        match /loadSummaries/{weekEnding} {
          allow read: if isMyBusiness(bid);
          allow write: if isMyBusiness(bid) && myProfile().role == 'business_owner';
        }
        match /marginTotals/{weekEnding} {
          allow read: if isMyBusiness(bid);
          allow write: if isMyBusiness(bid) && myProfile().role == 'business_owner';
        }
        match /orders/{weekEnding} {
          allow read: if isMyBusiness(bid);
          allow write: if isMyBusiness(bid) && myProfile().role == 'business_owner';
        }
        // Discord daily activity: grain is route-DAY (doc id = yyyy-mm-dd).
        match /activity/{date} {
          allow read: if isMyBusiness(bid);
          allow write: if isMyBusiness(bid) && myProfile().role == 'business_owner';
        }
        // Capture-first intake (2026-11-10): one doc per photo/voice
        // capture at routes/{rid}/captures/{captureId}. Written by the
        // driver who shot it; the backend reader (Admin SDK) fills the
        // extracted values. Tenant isolation is the business check, same
        // as eod/photos above.
        match /captures/{captureId} {
          allow read, write: if isMyBusiness(bid);
        }
        // Generated driver guide book + route card (2026-11-10): written
        // by the settlement ingest backend (Admin SDK) when a settlement
        // lands for the route. Members read; only owners write from a
        // client (manual repair path), mirroring settlements.
        match /guides/{weekEnding} {
          allow read: if isMyBusiness(bid);
          allow write: if isMyBusiness(bid) && myProfile().role == 'business_owner';
        }
      }

      // Ingestion registry: one entry per ingested item, any source.
      // Written by the backend via Admin SDK; members read, owners repair.
      match /ingestionRegistry/{ingestId} {
        allow read: if isMyBusiness(bid);
        allow write: if isMyBusiness(bid) && myProfile().role == 'business_owner';
      }

      // Fleet + team + catalog collections.
      match /trucks/{tid} {
        allow read, write: if isMyBusiness(bid);
      }
      match /employees/{eid} {
        allow read, write: if isMyBusiness(bid);
      }
      match /products/{pid} {
        allow read, write: if isMyBusiness(bid);
      }
      match /saleAlerts/{said} {
        allow read, write: if isMyBusiness(bid);
      }

      // Owner-initiated data-feed requests + CSV imports.
      match /dataFeedRequests/{drid} {
        allow read, write: if isMyBusiness(bid);
      }
      match /csv/{csvid} {
        allow read, write: if isMyBusiness(bid);
      }
    }

    // ------------------------------------------------------------------
    // AI assistant collections (added 2026-09-28).
    //
    // agentInbox: a business owner can read their own business's items.
    // Only the backend function (Admin SDK) writes. Drivers see the
    // reply via their readable assistant thread, not the inbox itself.
    match /agentInbox/{id} {
      allow read: if isAuthed()
        && myProfile().role == 'business_owner'
        && resource.data.businessId == myBusiness();
    }

    // assistant_config (the brain file): function-only via Admin SDK.
    // No client access at all.
    match /assistant_config/{doc} {
      allow read, write: if false;
    }
  }
}
